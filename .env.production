# Canonical site URL (custom domain)
NEXT_PUBLIC_SITE_URL=https://msbee.dpdns.org
# Google Analytics 4 — real Measurement ID (set 2026-08-10).
# .env.production is loaded by Next.js during `next build`, so NEXT_PUBLIC_*
# vars here get inlined into the production bundle on Vercel.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5XSTHGMGPF
